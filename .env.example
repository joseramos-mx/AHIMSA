# Supabase (solo servidor: NO usar el prefijo NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n: webhook que recibe cada lead nuevo y el secreto que va en el header
# x-webhook-secret
N8N_LEADS_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Sal para el hash SHA-256 de la IP (límite de envíos). Cadena larga y aleatoria.
IP_HASH_SALT=

# Opcional: dominio público del sitio (metadataBase, sitemap)
NEXT_PUBLIC_SITE_URL=
